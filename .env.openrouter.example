# ============================================
# OPENROUTER CONFIGURATION - QUICK START
# ============================================
# Copy this to your .env file and update with your keys

# AI Provider Selection
AI_PROVIDER=openrouter

# OpenRouter API Key (Get from: https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Model Selection (Choose one below or see https://openrouter.ai/models)
# Recommended: Claude 3.5 Sonnet for best quality
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ============================================
# POPULAR MODEL OPTIONS
# ============================================

# PREMIUM MODELS (Best Quality, Higher Cost)
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# OPENROUTER_MODEL=openai/gpt-4-turbo
# OPENROUTER_MODEL=google/gemini-pro-1.5

# BALANCED MODELS (Good Quality, Moderate Cost)
# OPENROUTER_MODEL=anthropic/claude-3-haiku
# OPENROUTER_MODEL=openai/gpt-3.5-turbo
# OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct

# ECONOMICAL MODELS (Lower Cost)
# OPENROUTER_MODEL=openai/gpt-3.5-turbo
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
# OPENROUTER_MODEL=google/gemini-flash-1.5

# ============================================
# OPTIONAL: GEMINI FALLBACK
# ============================================
# Keep Gemini as backup if OpenRouter fails
# GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# ALTERNATIVE: USE GEMINI AS PRIMARY
# ============================================
# To use Gemini instead of OpenRouter:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key-here
